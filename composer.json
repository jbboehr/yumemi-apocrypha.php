{
    "name": "jbboehr/yumemi-apocrypha",
    "description": "Curated PHPStan unit annotations for third-party PHP packages.",
    "type": "phpstan-extension",
    "license": "AGPL-3.0-only WITH romic-exception",
    "homepage": "https://github.com/jbboehr/yumemi-apocrypha.php",
    "support": {
        "issues": "https://github.com/jbboehr/yumemi-apocrypha.php/issues",
        "source": "https://github.com/jbboehr/yumemi-apocrypha.php"
    },
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jbboehr/phpbench-perfidious"
        }
    ],
    "archive": {
        "exclude": [
            "/.codex",
            "/.direnv",
            "/.dvc",
            "/.envrc",
            "/.github",
            "/.gitignore",
            "/.idea",
            "/.phpbench",
            "/.php-cs-fixer.cache",
            "/.php-cs-fixer.dist.php",
            "/.phpunit.cache",
            "/.pre-commit-cache",
            "/.pre-commit-config.yaml",
            "/AGENTS.md",
            "/Makefile",
            "/benchmarks",
            "/build",
            "/clover.xml",
            "/composer.lock",
            "/coverage",
            "/docs/book.toml",
            "/docs/development",
            "/docs/pages/images/logia",
            "/docs/theme",
            "/flake.lock",
            "/flake.nix",
            "/infection.json5.dist",
            "/*.log",
            "/nix",
            "/phpbench-perfidious.json",
            "/phpbench.json",
            "/phpstan.neon.dist",
            "/phpunit.branch.xml.dist",
            "/phpunit.xml.dist",
            "/result*",
            "/secrets",
            "/tests",
            "/tmp*",
            "/tools",
            "/vendor"
        ]
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.0",
        "jbboehr/yumemi": "^0.1",
        "phpstan/phpstan": "^2.2.5"
    },
    "suggest": {
        "larastan/larastan": "Adds Laravel-specific analysis while Apocrypha preserves selected Illuminate unit boundaries.",
        "phpstan/extension-installer": "Automatically registers Yumemi and Yumemi Apocrypha with PHPStan."
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\Yumemi\\Apocrypha\\": "src"
        }
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-zip": "*",
        "composer/metadata-minifier": "^1.0.1",
        "composer/semver": "^3.4",
        "friendsofphp/php-cs-fixer": "^3",
        "infection/infection": "^0.32.6",
        "jbboehr/akashi": "dev-master",
        "jbboehr/doctrine-of-the-second-sun": "dev-master",
        "jbboehr/phpbench-perfidious": "dev-master",
        "nikic/php-parser": "^5.8",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.13",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/process": "^7.4"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\Yumemi\\Apocrypha\\Benchmarks\\": "benchmarks/",
            "jbboehr\\Yumemi\\Apocrypha\\Tools\\": "tools/",
            "jbboehr\\Yumemi\\Apocrypha\\Tests\\": "tests"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --error-format=raw --memory-limit=1G",
        "benchmark": "phpbench run --report=aggregate",
        "benchmark:bookstack": [
            "Composer\\Config::disableProcessTimeout",
            "benchmarks/bookstack/run"
        ],
        "benchmark:perf": "phpbench run --config=phpbench-perfidious.json --report=perfidious",
        "benchmark:smoke": "phpbench run --iterations=1 --revs=1 --warmup=1 --progress=none",
        "check": [
            "@composer:validate",
            "@check:whitespace",
            "@cs",
            "@analyse",
            "@test"
        ],
        "check:full": [
            "@check",
            "@docs:check",
            "@benchmark:smoke",
            "@package:check"
        ],
        "check:whitespace": "git diff --check",
        "composer:validate": "composer validate --strict",
        "coverage:branch": "make coverage-branch",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "docs": "make docs",
        "docs:check": "make docs-check",
        "docs:serve": "make docs-serve",
        "infection": "infection --no-progress",
        "infection:ci": "infection --no-progress --min-msi=90 --min-covered-msi=90",
        "package:check": "php tools/check-package.php",
        "release:check": [
            "Composer\\Config::disableProcessTimeout",
            "tests/Release/run"
        ],
        "survey:candidates": "php tools/stub-candidate-survey.php",
        "test": "phpunit --colors=never --no-coverage",
        "test:consumer:carbon": "make test-consumer-carbon",
        "test:consumer:carbon:archive": "make test-consumer-carbon-archive",
        "test:consumer:getid3": "make test-consumer-getid3",
        "test:consumer:getid3:archive": "make test-consumer-getid3-archive",
        "test:consumer:guzzle": "make test-consumer-guzzle",
        "test:consumer:guzzle:archive": "make test-consumer-guzzle-archive",
        "test:consumer:intervention-image": "make test-consumer-intervention-image",
        "test:consumer:intervention-image:archive": "make test-consumer-intervention-image-archive",
        "test:consumer:illuminate-auth": "make test-consumer-illuminate-auth",
        "test:consumer:illuminate-auth:archive": "make test-consumer-illuminate-auth-archive",
        "test:consumer:illuminate-cache": "make test-consumer-illuminate-cache",
        "test:consumer:illuminate-cache:archive": "make test-consumer-illuminate-cache-archive",
        "test:consumer:illuminate-cookie": "make test-consumer-illuminate-cookie",
        "test:consumer:illuminate-database": "make test-consumer-illuminate-database",
        "test:consumer:illuminate-filesystem": "make test-consumer-illuminate-filesystem",
        "test:consumer:illuminate-http": "make test-consumer-illuminate-http",
        "test:consumer:illuminate-http:archive": "make test-consumer-illuminate-http-archive",
        "test:consumer:illuminate-process": "make test-consumer-illuminate-process",
        "test:consumer:illuminate-queue": "make test-consumer-illuminate-queue",
        "test:consumer:illuminate-redis": "make test-consumer-illuminate-redis",
        "test:consumer:illuminate-routing": "make test-consumer-illuminate-routing",
        "test:consumer:illuminate-session": "make test-consumer-illuminate-session",
        "test:consumer:illuminate-support": "make test-consumer-illuminate-support",
        "test:consumer:illuminate-validation": "make test-consumer-illuminate-validation",
        "test:consumer:laravel-framework": "make test-consumer-laravel-framework",
        "test:consumer:laravel-framework:archive": "make test-consumer-laravel-framework-archive",
        "test:consumer:measurements": "make test-consumer-measurements",
        "test:consumer:measurements:archive": "make test-consumer-measurements-archive",
        "test:consumer:phpgeo": "make test-consumer-phpgeo",
        "test:consumer:phpgeo:archive": "make test-consumer-phpgeo-archive",
        "test:consumer:symfony-http-foundation": "make test-consumer-symfony-http-foundation",
        "test:consumer:symfony-http-foundation:archive": "make test-consumer-symfony-http-foundation-archive",
        "test:consumer:symfony-stopwatch": "make test-consumer-symfony-stopwatch",
        "test:consumer:symfony-stopwatch:archive": "make test-consumer-symfony-stopwatch-archive",
        "test:consumer:manual": "make test-consumer-manual"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
