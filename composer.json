{
    "name": "jbboehr/yumemi-apocrypha",
    "description": "Curated PHPStan unit annotations for third-party PHP packages.",
    "type": "phpstan-extension",
    "license": "AGPL-3.0-only WITH romic-exception",
    "homepage": "https://github.com/jbboehr/yumemi-apocrypha.php",
    "support": {
        "issues": "https://github.com/jbboehr/yumemi-apocrypha.php/issues",
        "source": "https://github.com/jbboehr/yumemi-apocrypha.php"
    },
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "archive": {
        "exclude": [
            "/.codex",
            "/.direnv",
            "/.envrc",
            "/.github",
            "/.gitignore",
            "/.idea",
            "/.php-cs-fixer.cache",
            "/.php-cs-fixer.dist.php",
            "/.phpunit.cache",
            "/.pre-commit-cache",
            "/.pre-commit-config.yaml",
            "/AGENTS.md",
            "/Makefile",
            "/build",
            "/clover.xml",
            "/composer.lock",
            "/coverage",
            "/docs/DOCTRINE-CODING-GUIDE.md",
            "/docs/DOCTRINE-IMAGE-GUIDE.md",
            "/docs/DOCTRINE-STYLE-GUIDE.md",
            "/docs/book.toml",
            "/docs/development",
            "/docs/theme",
            "/flake.lock",
            "/flake.nix",
            "/infection.json5.dist",
            "/*.log",
            "/phpstan.neon.dist",
            "/phpunit.branch.xml.dist",
            "/phpunit.xml.dist",
            "/result*",
            "/tests",
            "/vendor"
        ]
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.0",
        "jbboehr/yumemi": "dev-master",
        "phpstan/phpstan": "^2.2.5"
    },
    "suggest": {
        "phpstan/extension-installer": "Automatically registers Yumemi and Yumemi Apocrypha with PHPStan."
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\Yumemi\\Apocrypha\\": "src"
        }
    },
    "require-dev": {
        "ext-dom": "*",
        "friendsofphp/php-cs-fixer": "^3",
        "infection/infection": "^0.32.6",
        "phpstan/phpstan-phpunit": "^2.0.13",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\Yumemi\\Apocrypha\\Tests\\": "tests"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "coverage:branch": "make coverage-branch",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "docs": "make docs",
        "docs:check": "make docs-check",
        "docs:serve": "make docs-serve",
        "infection": "infection --no-progress",
        "infection:ci": "infection --no-progress --min-msi=90 --min-covered-msi=90",
        "test:consumer:illuminate-cache": "make test-consumer-illuminate-cache",
        "test:consumer:illuminate-cache:archive": "make test-consumer-illuminate-cache-archive",
        "test:consumer:illuminate-http": "make test-consumer-illuminate-http",
        "test:consumer:illuminate-http:archive": "make test-consumer-illuminate-http-archive",
        "test:consumer:illuminate-support": "make test-consumer-illuminate-support",
        "test:consumer:manual": "make test-consumer-manual"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
