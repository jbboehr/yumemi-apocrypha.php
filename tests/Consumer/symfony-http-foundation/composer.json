{
    "name": "jbboehr/yumemi-apocrypha-consumer-symfony-http-foundation",
    "description": "Isolated Symfony HttpFoundation consumer fixture for Yumemi Apocrypha.",
    "type": "project",
    "license": "AGPL-3.0-only WITH romic-exception",
    "require": {
        "jbboehr/yumemi-apocrypha": "dev-consumer"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
