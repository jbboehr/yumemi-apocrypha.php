#!/usr/bin/env bash

set -euo pipefail

FIXTURES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly FIXTURES_DIR
PROJECT_ROOT=$(cd -- "$FIXTURES_DIR/../.." && pwd)
readonly PROJECT_ROOT
readonly PACKAGE_MODE=${1:-source}
readonly FIXTURE_SUITE=${2:-illuminate-cache}
readonly FRAMEWORK_MAJOR=${3:-12}
readonly YUMEMI_PACKAGE_DIR=${YUMEMI_PACKAGE_DIR:-$PROJECT_ROOT/..}

WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/yumemi-apocrypha-consumer.XXXXXXXX")
readonly WORK_DIR
trap 'rm -rf -- "$WORK_DIR"' EXIT

package_dir=$PROJECT_ROOT

if [[ $PACKAGE_MODE == archive ]]; then
    archive_dir=$WORK_DIR/archive
    package_dir=$WORK_DIR/package
    mkdir -p -- "$archive_dir" "$package_dir"

    composer --working-dir="$PROJECT_ROOT" archive --format=tar --dir="$archive_dir" --no-interaction

    archives=("$archive_dir"/*.tar)
    if [[ ${#archives[@]} -ne 1 || ! -f ${archives[0]} ]]; then
        printf 'Expected exactly one Composer archive in %s.\n' "$archive_dir" >&2
        exit 1
    fi

    tar -xf "${archives[0]}" -C "$package_dir"

    required_paths=(
        apocrypha.neon
        composer.json
        docs/LARAVEL-COPYRIGHT
        docs/LICENSE_EXCEPTION.md
        docs/pages/images/yumemi-banner.png
        extension.neon
        src/PHPStan/ConfiguredIntegrationStubFilesExtension.php
        stubs/illuminate/cache.stub
        stubs/illuminate/http.stub
    )
    for path in "${required_paths[@]}"; do
        if [[ ! -e $package_dir/$path ]]; then
            printf 'Composer archive is missing required path %s.\n' "$path" >&2
            exit 1
        fi
    done

    excluded_paths=(
        .codex
        .github
        .phpunit.cache
        docs/development
        tests
        vendor
    )
    for path in "${excluded_paths[@]}"; do
        if [[ -e $package_dir/$path ]]; then
            printf 'Composer archive contains excluded path %s.\n' "$path" >&2
            exit 1
        fi
    done
elif [[ $PACKAGE_MODE != source ]]; then
    printf 'Usage: %s [source|archive] [illuminate-cache|illuminate-http|manual] [framework-major]\n' "$0" >&2
    exit 2
fi

# The single-quoted argument is a PHP program, not a shell expression.
# shellcheck disable=SC2016
repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => $argv[1],
    "options" => [
        "symlink" => false,
        "versions" => ["jbboehr/yumemi-apocrypha" => "dev-consumer"],
    ],
], JSON_THROW_ON_ERROR);
' "$package_dir")
readonly repository_json

yumemi_repository_json=''
# The single-quoted argument is a PHP program, not a shell expression.
# shellcheck disable=SC2016
if [[ -f $YUMEMI_PACKAGE_DIR/composer.json ]] && php -r '
$metadata = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
exit(($metadata["name"] ?? null) === "jbboehr/yumemi" ? 0 : 1);
' "$YUMEMI_PACKAGE_DIR/composer.json"; then
    # shellcheck disable=SC2016
    yumemi_repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => $argv[1],
    "options" => [
        "symlink" => false,
        "versions" => ["jbboehr/yumemi" => "dev-master"],
    ],
], JSON_THROW_ON_ERROR);
' "$YUMEMI_PACKAGE_DIR")
fi
readonly yumemi_repository_json

run_phpstan_case() {
    local project_dir=$1
    local configuration=$2
    local case_file=$3
    local output
    shift 3
    local expected_diagnostics=("$@")
    local phpstan=(vendor/bin/phpstan analyse --no-progress --error-format=raw --configuration="$configuration")

    if [[ $case_file == valid.php ]]; then
        (
            cd -- "$project_dir"
            "${phpstan[@]}" "cases/$case_file"
        )

        return
    fi

    if output=$(
        cd -- "$project_dir"
        "${phpstan[@]}" "cases/$case_file" 2>&1
    ); then
        printf '%s unexpectedly accepted invalid units with %s.\n' "$FIXTURE_SUITE" "$configuration" >&2
        exit 1
    fi

    for diagnostic in "${expected_diagnostics[@]}"; do
        if [[ $output != *"$diagnostic"* ]]; then
            printf '%s missed diagnostic %s with %s:\n%s\n' \
                "$FIXTURE_SUITE" "$diagnostic" "$configuration" "$output" >&2
            exit 1
        fi
    done
}

run_illuminate_cache() {
    local project_dir=$WORK_DIR/illuminate-cache
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local getting_started_case=$project_dir/cases/getting-started-invalid.php
    local readme_case=$project_dir/cases/readme-invalid.php
    local expected_diagnostics=(
        "expects unit_int<'second'>, int given"
        "expects unit_int<'second'>, unit_int<'meter'> given"
        "Illuminate\\Contracts\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        "Illuminate\\Contracts\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, unit_int<'minute'> given"
        "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, unit_int<'minute'> given"
        "Repository::setDefaultCacheTime() expects unit_int<'second'>|null, int given"
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, int given"
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, unit_int<'minute'> given"
        "expects unit_int<'1/1000 * second'>, unit_int<'second'> given"
        "expects unit_int<'minute'>, unit_int<'second'> given"
    )

    if [[ ! $FRAMEWORK_MAJOR =~ ^(11|12|13)$ ]]; then
        printf 'Illuminate Cache consumer tests require framework major 11, 12, or 13.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/illuminate-cache/." "$project_dir/"

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    if [[ -n $yumemi_repository_json ]]; then
        composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
    fi
    composer --working-dir="$project_dir" require --dev "illuminate/cache:^$FRAMEWORK_MAJOR.0" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    php "$project_dir/verify.php"
    php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
        "$PROJECT_ROOT/docs/pages/integrations.md" illuminate-cache-invalid > "$documentation_case"
    php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
        "$PROJECT_ROOT/docs/pages/getting-started.md" getting-started-invalid > "$getting_started_case"
    php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
        "$PROJECT_ROOT/README.md" readme-cache-invalid > "$readme_case"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan.neon documentation-invalid.php \
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, unit_int<'minute'> given"
    run_phpstan_case "$project_dir" phpstan.neon getting-started-invalid.php \
        "Store::put() expects unit_int<'second'>, unit_int<'minute'> given"
    run_phpstan_case "$project_dir" phpstan.neon readme-invalid.php \
        "Store::put() expects unit_int<'second'>, unit_int<'minute'> given"
}

run_illuminate_http() {
    local project_dir=$WORK_DIR/illuminate-http
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local expected_diagnostics=(
        "::timeout() expects unit_float<'second'>|unit_int<'second'>, int given"
        "::timeout() expects unit_float<'second'>|unit_int<'second'>, unit_int<'1/1000 * second'> given"
        "::timeout() expects unit_float<'second'>|unit_int<'second'>, unit_int<'meter'> given"
        "::connectTimeout() expects unit_float<'second'>|unit_int<'second'>, unit_int<'minute'> given"
        "::retry() expects (Closure(int, mixed): int)|unit_int<'1/1000 * second'>, 250 given"
        "::retry() expects (Closure(int, mixed): int)|unit_int<'1/1000 * second'>, unit_int<'second'> given"
        "::retry() expects array<int, unit_int<'1/1000 * second'>>|int, array<int, int> given"
        "::retry() expects array<int, unit_int<'1/1000 * second'>>|int, array<int, unit_int<'second'>> given"
        "::retry() expects (Closure(int, mixed): int)|unit_int<'1/1000 * second'>, Closure(int, mixed): 250 given"
        "FileFactory::create() expects string|unit_int<'1024 * octet'>, int given"
        "FileFactory::create() expects string|unit_int<'1024 * octet'>, unit_int<'1000 * octet'> given"
        "FileFactory::create() expects string|unit_int<'1024 * octet'>, unit_int<'second'> given"
        "File::create() expects string|unit_int<'1024 * octet'>, int given"
        "File::size() expects unit_int<'1024 * octet'>, unit_int<'1000 * octet'> given"
        "acceptHttpSeconds expects unit_int<'second'>, unit_int<'octet'> given"
    )

    if [[ ! $FRAMEWORK_MAJOR =~ ^(11|12|13)$ ]]; then
        printf 'Illuminate HTTP consumer tests require framework major 11, 12, or 13.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/illuminate-http/." "$project_dir/"

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    if [[ -n $yumemi_repository_json ]]; then
        composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
    fi
    composer --working-dir="$project_dir" require --dev "illuminate/http:^$FRAMEWORK_MAJOR.0" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    php "$project_dir/verify.php"
    php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
        "$PROJECT_ROOT/docs/pages/integrations.md" illuminate-http-invalid > "$documentation_case"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan.neon documentation-invalid.php \
        "::timeout() expects unit_float<'second'>|unit_int<'second'>, unit_int<'1/1000 * second'> given"
}

run_manual() {
    local project_dir=$WORK_DIR/manual

    if [[ $FRAMEWORK_MAJOR != 12 ]]; then
        printf 'The manual-registration smoke test uses Illuminate Cache major 12.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/manual/." "$project_dir/"

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    if [[ -n $yumemi_repository_json ]]; then
        composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
    fi
    composer --working-dir="$project_dir" require --dev "illuminate/cache:^$FRAMEWORK_MAJOR.0" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php \
        "Store::put() expects unit_int<'second'>, int given"
}

case $FIXTURE_SUITE in
    illuminate-cache)
        run_illuminate_cache
        ;;
    illuminate-http)
        run_illuminate_http
        ;;
    manual)
        run_manual
        ;;
    *)
        printf 'Usage: %s [source|archive] [illuminate-cache|illuminate-http|manual] [framework-major]\n' "$0" >&2
        exit 2
        ;;
esac

printf '%s consumer package tests passed using the %s package.\n' "$FIXTURE_SUITE" "$PACKAGE_MODE"
