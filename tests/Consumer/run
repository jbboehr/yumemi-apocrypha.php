#!/usr/bin/env bash

set -euo pipefail

FIXTURES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly FIXTURES_DIR
PROJECT_ROOT=$(cd -- "$FIXTURES_DIR/../.." && pwd)
readonly PROJECT_ROOT
AKASHI=$PROJECT_ROOT/vendor/bin/akashi
readonly AKASHI
DOCUMENTATION_EXAMPLE_RESOLVER=$PROJECT_ROOT/tests/Documentation/resolve-consumer-example.php
readonly DOCUMENTATION_EXAMPLE_RESOLVER
PACKAGE_CHECKER=$PROJECT_ROOT/tools/check-package.php
readonly PACKAGE_CHECKER
readonly PACKAGE_MODE=${1:-source}
readonly FIXTURE_SUITE=${2:-illuminate-cache}
readonly PACKAGE_MAJOR=${3:-12}
readonly COMPATIBILITY_MODE=${4:-plain}
readonly CONSUMER_VENDOR_DIR=${CONSUMER_VENDOR_DIR:-vendor}
readonly APOCRYPHA_PACKAGE_VERSION=${APOCRYPHA_PACKAGE_VERSION:-dev-consumer}
readonly CONSUMER_MINIMUM_STABILITY=${CONSUMER_MINIMUM_STABILITY:-dev}
readonly CONSUMER_DEPENDENCIES_ONLY=${CONSUMER_DEPENDENCIES_ONLY:-0}
readonly CONSUMER_DOWNLOAD_ONLY=${CONSUMER_DOWNLOAD_ONLY:-0}
readonly CONSUMER_LOCK_FILE=${CONSUMER_LOCK_FILE:-}
readonly CONSUMER_LOCK_OUTPUT=${CONSUMER_LOCK_OUTPUT:-}
readonly VERIFY_GIT_ARCHIVE=${VERIFY_GIT_ARCHIVE:-1}
readonly PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR=${PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR:-}
readonly YUMEMI_PACKAGE_DIR=${YUMEMI_PACKAGE_DIR:-}

if [[ $CONSUMER_DEPENDENCIES_ONLY != 1 && ! -x $AKASHI ]]; then
    printf 'Akashi is not installed; run composer install in %s.\n' "$PROJECT_ROOT" >&2
    exit 1
fi

if [[ $COMPATIBILITY_MODE != plain && $COMPATIBILITY_MODE != larastan && $COMPATIBILITY_MODE != phpstan-laravel-validation && $COMPATIBILITY_MODE != phpstan-symfony ]]; then
    printf 'Compatibility mode must be plain, larastan, phpstan-laravel-validation, or phpstan-symfony; received %s.\n' "$COMPATIBILITY_MODE" >&2
    exit 2
fi

if [[ $CONSUMER_VENDOR_DIR == /* ]]; then
    printf 'The consumer vendor directory must be relative; received %s.\n' "$CONSUMER_VENDOR_DIR" >&2
    exit 2
fi

if [[ $CONSUMER_VENDOR_DIR != vendor && $FIXTURE_SUITE != guzzle && $FIXTURE_SUITE != manual ]]; then
    printf 'Nondefault consumer vendor-directory coverage is limited to the guzzle and manual fixtures.\n' >&2
    exit 2
fi

if [[ $CONSUMER_MINIMUM_STABILITY != dev && $CONSUMER_MINIMUM_STABILITY != stable ]]; then
    printf 'Consumer minimum stability must be dev or stable; received %s.\n' "$CONSUMER_MINIMUM_STABILITY" >&2
    exit 2
fi

if [[ $CONSUMER_DEPENDENCIES_ONLY != 0 && $CONSUMER_DEPENDENCIES_ONLY != 1 ]]; then
    printf 'Consumer dependency-only mode must be 0 or 1; received %s.\n' "$CONSUMER_DEPENDENCIES_ONLY" >&2
    exit 2
fi

if [[ $CONSUMER_DOWNLOAD_ONLY != 0 && $CONSUMER_DOWNLOAD_ONLY != 1 ]]; then
    printf 'Consumer download-only mode must be 0 or 1; received %s.\n' "$CONSUMER_DOWNLOAD_ONLY" >&2
    exit 2
fi

if [[ $CONSUMER_DOWNLOAD_ONLY == 1 && -z $CONSUMER_LOCK_FILE ]]; then
    printf 'Consumer download-only mode requires a lock input.\n' >&2
    exit 2
fi

if [[ -n $CONSUMER_LOCK_FILE && -n $CONSUMER_LOCK_OUTPUT ]]; then
    printf 'Consumer lock input and output cannot be used together.\n' >&2
    exit 2
fi

if [[ $VERIFY_GIT_ARCHIVE != 0 && $VERIFY_GIT_ARCHIVE != 1 ]]; then
    printf 'Git archive verification must be 0 or 1; received %s.\n' "$VERIFY_GIT_ARCHIVE" >&2
    exit 2
fi

case $COMPATIBILITY_MODE in
    larastan)
        case $FIXTURE_SUITE in
            carbon | illuminate-* | laravel-framework) ;;
            *)
                printf 'Larastan compatibility mode does not support the %s consumer.\n' "$FIXTURE_SUITE" >&2
                exit 2
                ;;
        esac
        ;;
    phpstan-laravel-validation)
        if [[ $FIXTURE_SUITE != illuminate-validation ]]; then
            printf 'Laravel Validation extension compatibility mode does not support the %s consumer.\n' "$FIXTURE_SUITE" >&2
            exit 2
        fi
        ;;
    phpstan-symfony)
        case $FIXTURE_SUITE in
            symfony-http-foundation | symfony-stopwatch) ;;
            *)
                printf 'phpstan-symfony compatibility mode does not support the %s consumer.\n' "$FIXTURE_SUITE" >&2
                exit 2
                ;;
        esac
        ;;
esac

WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/yumemi-apocrypha-consumer.XXXXXXXX")
readonly WORK_DIR
trap 'rm -rf -- "$WORK_DIR"' EXIT

package_dir=$PROJECT_ROOT

if [[ $PACKAGE_MODE == archive && $CONSUMER_DEPENDENCIES_ONLY != 1 ]]; then
    archive_dir=$WORK_DIR/archive
    package_dir=$WORK_DIR/package
    mkdir -p -- "$archive_dir" "$package_dir"

    composer --working-dir="$PROJECT_ROOT" archive --format=tar --dir="$archive_dir" --no-interaction

    archives=("$archive_dir"/*.tar)
    if [[ ${#archives[@]} -ne 1 || ! -f ${archives[0]} ]]; then
        printf 'Expected exactly one Composer archive in %s.\n' "$archive_dir" >&2
        exit 1
    fi

    php "$PACKAGE_CHECKER" "${archives[0]}"
    tar -xf "${archives[0]}" -C "$package_dir"

    if [[ $VERIFY_GIT_ARCHIVE == 1 ]]; then
        git_archive=$archive_dir/git-package.tar
        git -C "$PROJECT_ROOT" archive --worktree-attributes --format=tar --output="$git_archive" HEAD
        php "$PACKAGE_CHECKER" "$git_archive"
    fi
elif [[ $PACKAGE_MODE != source && $PACKAGE_MODE != archive ]]; then
    printf 'Usage: %s [source|archive] [carbon|getid3|guzzle|illuminate-auth|illuminate-bus|illuminate-cache|illuminate-console|illuminate-cookie|illuminate-database|illuminate-filesystem|illuminate-http|illuminate-mail|illuminate-process|illuminate-queue|illuminate-redis|illuminate-routing|illuminate-session|illuminate-support|illuminate-validation|intervention-image|laravel-framework|measurements|phpgeo|symfony-http-foundation|symfony-stopwatch|manual] [package-version] [plain|larastan|phpstan-laravel-validation|phpstan-symfony]\n' "$0" >&2
    exit 2
fi

yumemi_repository_json=''
# The single-quoted argument is a PHP program, not a shell expression.
# shellcheck disable=SC2016
if [[ -n $YUMEMI_PACKAGE_DIR && -f $YUMEMI_PACKAGE_DIR/composer.json ]] && php -r '
$metadata = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
exit(($metadata["name"] ?? null) === "jbboehr/yumemi" ? 0 : 1);
' "$YUMEMI_PACKAGE_DIR/composer.json"; then
    # shellcheck disable=SC2016
    yumemi_repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => ".yumemi-package",
    "options" => [
        "symlink" => $argv[1] === "source",
        "reference" => "none",
        "versions" => ["jbboehr/yumemi" => "dev-master"],
    ],
], JSON_THROW_ON_ERROR);
' "$PACKAGE_MODE")
fi
readonly yumemi_repository_json
export COMPOSER_VENDOR_DIR=$CONSUMER_VENDOR_DIR

configure_apocrypha_repository() {
    local project_dir=$1
    local repository_json
    local repository_mode=$PACKAGE_MODE

    # Lock generation and locked installs must use identical, cheap path transport. Archive-mode tests still build and
    # inspect the archive before symlinking its extracted payload.
    if [[ $CONSUMER_DEPENDENCIES_ONLY == 1 || -n $CONSUMER_LOCK_FILE ]]; then
        repository_mode=source
    fi

    ln -s -- "$package_dir" "$project_dir/.apocrypha-package"

    # Keep the path repository URL stable so generated consumer locks work in independent build directories.
    # The single-quoted argument is a PHP program, not a shell expression.
    # shellcheck disable=SC2016
    repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => ".apocrypha-package",
    "options" => [
        "symlink" => $argv[1] === "source",
        "reference" => "none",
        "versions" => ["jbboehr/yumemi-apocrypha" => $argv[2]],
    ],
], JSON_THROW_ON_ERROR);
' "$repository_mode" "$APOCRYPHA_PACKAGE_VERSION")

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    composer --working-dir="$project_dir" config minimum-stability "$CONSUMER_MINIMUM_STABILITY" --no-interaction
    composer --working-dir="$project_dir" require \
        "jbboehr/yumemi-apocrypha:$APOCRYPHA_PACKAGE_VERSION" --no-update --no-interaction
}

configure_yumemi_repository() {
    local project_dir=$1

    if [[ -z $yumemi_repository_json ]]; then
        return
    fi

    ln -s -- "$YUMEMI_PACKAGE_DIR" "$project_dir/.yumemi-package"
    composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
}

install_consumer_dependencies() {
    local project_dir=$1
    local lock_output_dir
    local composer_install_options=(--prefer-dist --no-interaction --no-progress)
    local composer_update_options=(--prefer-dist --no-interaction --no-progress)

    if [[ $CONSUMER_DOWNLOAD_ONLY == 1 ]]; then
        composer_install_options+=(--download-only)
    fi
    if [[ -n $CONSUMER_LOCK_OUTPUT ]]; then
        composer_update_options+=(--no-install)
    fi

    if [[ -n $CONSUMER_LOCK_FILE ]]; then
        if [[ ! -f $CONSUMER_LOCK_FILE ]]; then
            printf 'Consumer lock file does not exist: %s.\n' "$CONSUMER_LOCK_FILE" >&2
            exit 2
        fi
        cp -- "$CONSUMER_LOCK_FILE" "$project_dir/composer.lock"
        composer --working-dir="$project_dir" validate --strict --no-check-publish --no-interaction
        composer --working-dir="$project_dir" install "${composer_install_options[@]}"
    else
        composer --working-dir="$project_dir" update "${composer_update_options[@]}"
    fi

    if [[ -n $CONSUMER_LOCK_OUTPUT ]]; then
        lock_output_dir=$(dirname -- "$CONSUMER_LOCK_OUTPUT")
        mkdir -p -- "$lock_output_dir"
        cp -- "$project_dir/composer.lock" "$CONSUMER_LOCK_OUTPUT"
    fi

    if [[ $CONSUMER_MINIMUM_STABILITY == stable && $CONSUMER_DOWNLOAD_ONLY != 1 && -z $CONSUMER_LOCK_OUTPUT ]]; then
        # The single-quoted argument is a PHP program, not a shell expression.
        # shellcheck disable=SC2016
        php -r '
require $argv[1].DIRECTORY_SEPARATOR.$argv[2].DIRECTORY_SEPARATOR."autoload.php";

$apocryphaVersion = Composer\InstalledVersions::getPrettyVersion("jbboehr/yumemi-apocrypha");
$yumemiVersion = Composer\InstalledVersions::getPrettyVersion("jbboehr/yumemi");

if ($apocryphaVersion !== $argv[3]) {
    fwrite(STDERR, sprintf(
        "Expected prospective Apocrypha %s, resolved %s.\n",
        $argv[3],
        var_export($apocryphaVersion, true),
    ));
    exit(1);
}

if ($yumemiVersion === null || preg_match("/^v?0\\.1\\.[0-9]+$/D", $yumemiVersion) !== 1) {
    fwrite(STDERR, sprintf(
        "Expected a stable Yumemi 0.1 release, resolved %s.\n",
        var_export($yumemiVersion, true),
    ));
    exit(1);
}

printf("Stable dependency resolution: Apocrypha %s, Yumemi %s.\n", $apocryphaVersion, $yumemiVersion);
' "$project_dir" "$CONSUMER_VENDOR_DIR" "$APOCRYPHA_PACKAGE_VERSION"
    fi

    if [[ $CONSUMER_DEPENDENCIES_ONLY == 1 ]]; then
        printf 'Prepared dependencies for %s %s / %s.\n' \
            "$FIXTURE_SUITE" "$PACKAGE_MAJOR" "$COMPATIBILITY_MODE"
        exit 0
    fi
}

configure_laravel_advisory_whitelist() {
    local project_dir=$1

    if [[ $PACKAGE_MAJOR != *.* && $PACKAGE_MAJOR != 11 ]]; then
        return
    fi

    # Exact historical cutovers and every Laravel 11 tag are inside advisory ranges. These fixtures exercise package
    # metadata and static analysis only. Let Composer resolve those intentional profiles instead of silently preferring
    # an untagged development branch.
    composer --working-dir="$project_dir" config policy.advisories.block false
}

enable_larastan() {
    local project_dir=$1
    local testbench_major

    if [[ $COMPATIBILITY_MODE == larastan || $COMPATIBILITY_MODE == phpstan-laravel-validation ]]; then
        case $PACKAGE_MAJOR in
            11) testbench_major=9 ;;
            12) testbench_major=10 ;;
            13) testbench_major=11 ;;
            *)
                printf 'Larastan consumer tests require Laravel major 11, 12, or 13.\n' >&2
                exit 2
                ;;
        esac

        composer --working-dir="$project_dir" require --dev \
            "larastan/larastan:^3.0" \
            "orchestra/testbench:^$testbench_major.0" \
            --no-update --no-interaction
    fi
}

enable_phpstan_laravel_validation() {
    local project_dir=$1
    local validation_repository_json

    if [[ $COMPATIBILITY_MODE == phpstan-laravel-validation ]]; then
        if [[ -n $PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR ]]; then
            # The single-quoted argument is a PHP program, not a shell expression.
            # shellcheck disable=SC2016
            if [[ ! -f $PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR/composer.json ]] || ! php -r '
$metadata = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
exit(($metadata["name"] ?? null) === "jbboehr/phpstan-laravel-validation" ? 0 : 1);
' "$PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR/composer.json"; then
                printf 'PHPStan Laravel Validation package directory is invalid: %s.\n' \
                    "$PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR" >&2
                exit 2
            fi

            # The single-quoted argument is a PHP program, not a shell expression.
            # shellcheck disable=SC2016
            validation_repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => ".phpstan-laravel-validation-package",
    "options" => [
        "symlink" => true,
        "reference" => "none",
        "versions" => ["jbboehr/phpstan-laravel-validation" => "dev-master"],
    ],
], JSON_THROW_ON_ERROR);
')
            ln -s -- "$PHPSTAN_LARAVEL_VALIDATION_PACKAGE_DIR" \
                "$project_dir/.phpstan-laravel-validation-package"
            composer --working-dir="$project_dir" repo add phpstan-laravel-validation \
                "$validation_repository_json" --no-interaction
        else
            composer --working-dir="$project_dir" repo add phpstan-laravel-validation \
                vcs https://github.com/jbboehr/phpstan-laravel-validation.git --no-interaction
        fi
        composer --working-dir="$project_dir" require --dev \
            'jbboehr/phpstan-laravel-validation:dev-master' \
            --no-update --no-interaction
    fi
}

enable_phpstan_symfony() {
    local project_dir=$1

    if [[ $COMPATIBILITY_MODE == phpstan-symfony ]]; then
        composer --working-dir="$project_dir" require --dev \
            'phpstan/phpstan-symfony:^2.0' \
            --no-update --no-interaction
    fi
}

extract_documentation_case() {
    local consumer=$1
    local output_file=$2
    local marker=$3
    local document

    if [[ $consumer != "$FIXTURE_SUITE" ]]; then
        printf 'Documentation example %s is assigned to %s, not the running %s consumer.\n' \
            "$marker" "$consumer" "$FIXTURE_SUITE" >&2
        exit 1
    fi

    if ! document=$(php "$DOCUMENTATION_EXAMPLE_RESOLVER" document "$consumer" "$marker"); then
        exit 1
    fi
    php "$AKASHI" extract --marker-name=yumemi-example \
        "$PROJECT_ROOT/$document" "$marker" > "$output_file"
}

run_documentation_phpstan_case() {
    local consumer=$1
    local project_dir=$2
    local configuration=$3
    local output_file=$4
    local marker=$5
    local case_file=${output_file##*/}
    local expected_diagnostics=()
    local expectation_output

    extract_documentation_case "$consumer" "$output_file" "$marker"
    if ! expectation_output=$(
        php "$DOCUMENTATION_EXAMPLE_RESOLVER" expectations "$consumer" "$marker"
    ); then
        exit 1
    fi
    if [[ -z $expectation_output ]]; then
        printf 'Documentation example %s declares no PHPStan diagnostic expectations.\n' "$marker" >&2
        exit 1
    fi
    mapfile -t expected_diagnostics <<< "$expectation_output"

    run_phpstan_case "$project_dir" "$configuration" "$case_file" "${expected_diagnostics[@]}"
}

run_phpstan_case() {
    local project_dir=$1
    local configuration=$2
    local case_file=$3
    local output
    local stderr_file
    shift 3
    local expected_diagnostics=("$@")
    local phpstan=(
        php
        "$project_dir/$CONSUMER_VENDOR_DIR/bin/phpstan"
        analyse
        --no-progress
        --memory-limit=1G
        --configuration="$configuration"
    )

    if [[ $case_file == valid*.php ]]; then
        (
            cd -- "$project_dir"
            "${phpstan[@]}" --error-format=raw "cases/$case_file"
        )

        return
    fi

    stderr_file=$project_dir/.phpstan-stderr

    if output=$(
        cd -- "$project_dir"
        "${phpstan[@]}" --error-format=json "cases/$case_file" 2>"$stderr_file"
    ); then
        printf '%s unexpectedly accepted invalid units with %s.\n' "$FIXTURE_SUITE" "$configuration" >&2
        exit 1
    fi

    if ! printf '%s' "$output" | php "$PROJECT_ROOT/tests/Consumer/assert-phpstan-diagnostics.php" \
        "${expected_diagnostics[@]}"; then
        printf '%s diagnostic verification failed with %s.\n' "$FIXTURE_SUITE" "$configuration" >&2
        if [[ -s $stderr_file ]]; then
            printf 'PHPStan standard error:\n' >&2
            cat -- "$stderr_file" >&2
        fi
        printf 'PHPStan JSON output:\n%s\n' "$output" >&2
        exit 1
    fi
}

run_phpstan_without_apocrypha_diagnostic() {
    local project_dir=$1
    local configuration=$2
    local case_file=$3
    local output
    local phpstan=(
        php
        "$project_dir/$CONSUMER_VENDOR_DIR/bin/phpstan"
        analyse
        --no-progress
        --memory-limit=1G
        --error-format=json
        --configuration="$configuration"
    )

    output=$(
        cd -- "$project_dir"
        "${phpstan[@]}" "cases/$case_file" 2>&1 || true
    )

    if [[ $output == *'apocrypha.unit'* ]]; then
        printf '%s emitted a speculative unit diagnostic for an unknown unpack with %s:\n%s\n' \
            "$FIXTURE_SUITE" "$configuration" "$output" >&2
        exit 1
    fi
}

assert_stub_paths_use_consumer_install() {
    local project_dir=$1
    local integration=$2

    # The single-quoted argument is a PHP program, not a shell expression.
    # shellcheck disable=SC2016
    php -r '
require $argv[1].DIRECTORY_SEPARATOR.$argv[3].DIRECTORY_SEPARATOR."autoload.php";

$extension = new jbboehr\Yumemi\Apocrypha\PHPStan\ConfiguredIntegrationStubFilesExtension(
    [$argv[2]],
    false,
    true,
);
$files = $extension->getFiles();
if ($files === []) {
    fwrite(STDERR, sprintf("No stub files were registered for %s.\n", $argv[2]));
    exit(1);
}

$expectedPrefix = $argv[1].DIRECTORY_SEPARATOR.$argv[3].DIRECTORY_SEPARATOR
    ."jbboehr".DIRECTORY_SEPARATOR."yumemi-apocrypha".DIRECTORY_SEPARATOR;

foreach ($files as $file) {
    if (!str_starts_with($file, $expectedPrefix)) {
        fwrite(STDERR, sprintf("Stub path escaped the consumer package install: %s\n", $file));
        exit(1);
    }

    $relativePath = substr($file, strlen($expectedPrefix));
    if (
        $relativePath === ""
        || in_array("..", explode(DIRECTORY_SEPARATOR, $relativePath), true)
        || !is_file($file)
    ) {
        fwrite(STDERR, sprintf("Stub path is not a contained package file: %s\n", $file));
        exit(1);
    }
}
' "$project_dir" "$integration" "$CONSUMER_VENDOR_DIR"
}

run_carbon() {
    local project_dir=$WORK_DIR/carbon
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local package_constraint
    local profile
    local profile_method_prefix
    local expected_common_diagnostics=(
        "Carbon::sleep() expects unit_float<'second'>|unit_int<'second'>, int given"
        "Carbon::sleep() expects unit_float<'second'>|unit_int<'second'>, 1&unit_int<'minute'> given"
        "FactoryImmutable::sleep() expects unit_float<'second'>|unit_int<'second'>, 1&unit_int<'meter'> given"
        "WrapperClock::sleep() expects unit_float<'second'>|unit_int<'second'>, float given"
        "recordCarbonDistance expects unit_float<'meter'>, unit_float<'second'> given"
    )
    local expected_profile_diagnostics=()

    case $PACKAGE_MAJOR in
        2.62.1)
            package_constraint=2.62.1
            profile=2
            ;;
        2)
            package_constraint='^2.62.1'
            profile=2
            ;;
        3.0.0 | 3.1.1)
            package_constraint=$PACKAGE_MAJOR
            profile=3-real
            ;;
        3.2.0)
            package_constraint=3.2.0
            profile=3-utc
            ;;
        3)
            package_constraint='^3.2.0'
            profile=3-utc
            ;;
        *)
            printf 'Carbon consumer tests require version 2.62.1, 2, 3.0.0, 3.1.1, 3.2.0, or 3.\n' >&2
            exit 2
            ;;
    esac

    if [[ $COMPATIBILITY_MODE == larastan && $PACKAGE_MAJOR != 3 ]]; then
        printf 'The Carbon Larastan compatibility test uses the latest supported Carbon 3 release.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/carbon/." "$project_dir/"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "nesbot/carbon:$package_constraint" --no-update --no-interaction
    if [[ $PACKAGE_MAJOR == *.* ]]; then
        composer --working-dir="$project_dir" config \
            policy.advisories.ignore-id PKSA-csyb-yc4p-mnbs
    fi
    if [[ $COMPATIBILITY_MODE == larastan ]]; then
        composer --working-dir="$project_dir" require --dev \
            'larastan/larastan:^3.10' \
            'laravel/framework:^12.0' \
            'orchestra/testbench:^10.0' \
            --no-update --no-interaction
    fi
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php" "$profile"

    if [[ $profile == 2 ]]; then
        expected_profile_diagnostics=(
            "addRealSeconds() expects unit_int<'second'>, int given"
            "addRealSeconds() expects unit_int<'second'>, 5&unit_int<'minute'> given"
            "addRealSeconds() expects int, 0.5&unit_float<'second'> given"
            "recordCarbonTwoHours expects unit_int<'hour'>, unit_int<'second'> given"
        )
        run_phpstan_case "$project_dir" phpstan.neon valid-2.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-2.php
        run_phpstan_case "$project_dir" phpstan.neon invalid-2.php "${expected_profile_diagnostics[@]}"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-2.php "${expected_profile_diagnostics[@]}"

        return
    fi

    if [[ $profile == 3-real ]]; then
        profile_method_prefix=Real
    else
        profile_method_prefix=UTC
    fi
    expected_profile_diagnostics=(
        "add${profile_method_prefix}Seconds() expects unit_float<'second'>|unit_int<'second'>, int given"
        "add${profile_method_prefix}Seconds() expects unit_float<'second'>|unit_int<'second'>, 5&unit_int<'minute'> given"
        "unit_float<'hour'>, unit_float<'second'> given"
    )

    run_phpstan_case "$project_dir" phpstan.neon valid-3.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-3.php
    run_phpstan_case "$project_dir" phpstan.neon "valid-$profile.php"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "valid-$profile.php"
    run_phpstan_case "$project_dir" phpstan.neon invalid-3.php "${expected_common_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-3.php "${expected_common_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan.neon "invalid-$profile.php" "${expected_profile_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "invalid-$profile.php" "${expected_profile_diagnostics[@]}"

    if [[ $profile == 3-utc ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case carbon "$project_dir" phpstan.neon "$documentation_case" carbon-invalid
    fi
}

run_illuminate_cache() {
    local project_dir=$WORK_DIR/illuminate-cache
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local getting_started_case=$project_dir/cases/getting-started-invalid.php
    local readme_case=$project_dir/cases/readme-invalid.php
    local expected_diagnostics=(
        "expects unit_int<'second'>, int given"
        "expects unit_int<'second'>, 30&unit_int<'meter'> given"
        "Illuminate\\Contracts\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        "Illuminate\\Contracts\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, 2&unit_int<'minute'> given"
        "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, 2&unit_int<'minute'> given"
        "Repository::setDefaultCacheTime() expects unit_int<'second'>|null, int given"
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, int given"
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, 2&unit_int<'minute'> given"
        "expects unit_int<'1/1000 * second'>, 1&unit_int<'second'> given"
        "expects unit_int<'minute'>, 1&unit_int<'second'> given"
    )

    if [[ ! $PACKAGE_MAJOR =~ ^(11|12|13)$ ]]; then
        printf 'Illuminate Cache consumer tests require framework major 11, 12, or 13.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/illuminate-cache/." "$project_dir/"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev "illuminate/cache:^$PACKAGE_MAJOR.0" --no-update --no-interaction
    if [[ $COMPATIBILITY_MODE == larastan ]]; then
        configure_laravel_advisory_whitelist "$project_dir"
    fi
    enable_larastan "$project_dir"
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    if [[ $COMPATIBILITY_MODE == larastan ]]; then
        local larastan_entry_point_diagnostics=(
            "Illuminate\\Support\\Facades\\Cache::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
            "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        )
        run_phpstan_case "$project_dir" phpstan.neon valid-larastan.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-larastan.php
        run_phpstan_case "$project_dir" phpstan.neon invalid-larastan.php "${larastan_entry_point_diagnostics[@]}"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-larastan.php \
            "${larastan_entry_point_diagnostics[@]}"
    fi
    run_documentation_phpstan_case illuminate-cache "$project_dir" phpstan.neon "$documentation_case" illuminate-cache-invalid
    run_documentation_phpstan_case illuminate-cache "$project_dir" phpstan.neon "$getting_started_case" getting-started-invalid
    run_documentation_phpstan_case illuminate-cache "$project_dir" phpstan.neon "$readme_case" readme-cache-invalid
}

run_illuminate_http() {
    local project_dir=$WORK_DIR/illuminate-http
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local package_constraint
    local timeout_type="unit_float<'second'>|unit_int<'second'>"
    local supports_fractional_timeouts=1
    local expected_diagnostics=()

    case $PACKAGE_MAJOR in
        11.35.0)
            package_constraint=11.35.0
            timeout_type="unit_int<'second'>"
            supports_fractional_timeouts=0
            ;;
        11.35.1)
            package_constraint=11.35.1
            ;;
        11 | 12 | 13)
            package_constraint="^$PACKAGE_MAJOR.0"
            ;;
        *)
            printf 'Illuminate HTTP consumer tests require framework major 11, 12, 13, or profile 11.35.0/11.35.1.\n' >&2
            exit 2
            ;;
    esac

    if [[ $PACKAGE_MAJOR == *.* && $COMPATIBILITY_MODE != plain ]]; then
        printf 'Exact Illuminate HTTP profiles run in plain compatibility mode.\n' >&2
        exit 2
    fi

    expected_diagnostics=(
        "::timeout() expects $timeout_type, int given"
        "::timeout() expects $timeout_type, 30&unit_int<'1/1000 * second'> given"
        "::timeout() expects $timeout_type, 30&unit_int<'meter'> given"
        "::connectTimeout() expects $timeout_type, 30&unit_int<'minute'> given"
        "::retry() expects (Closure(int, mixed): int)|unit_int<'1/1000 * second'>, 250 given"
        "::retry() expects (Closure(int, mixed): int)|unit_int<'1/1000 * second'>, 1&unit_int<'second'> given"
        "::retry() expects array<int, unit_int<'1/1000 * second'>>|int, array<int, int> given"
        "::retry() expects array<int, unit_int<'1/1000 * second'>>|int, array<int, 1&unit_int<'second'>> given"
        "::retry() expects (Closure(int, mixed): int)|unit_int<'1/1000 * second'>, Closure(int, mixed): 250 given"
        "FileFactory::create() expects string|unit_int<'1024 * octet'>, int given"
        "FileFactory::create() expects string|unit_int<'1024 * octet'>, 2&unit_int<'1000 * octet'> given"
        "FileFactory::create() expects string|unit_int<'1024 * octet'>, 2&unit_int<'second'> given"
        "File::create() expects string|unit_int<'1024 * octet'>, int given"
        "File::size() expects unit_int<'1024 * octet'>, 2&unit_int<'1000 * octet'> given"
        "acceptHttpSeconds expects unit_int<'second'>, unit_int<'octet'> given"
    )

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/illuminate-http/." "$project_dir/"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "illuminate/http:$package_constraint" --no-update --no-interaction
    if [[ $COMPATIBILITY_MODE == larastan ]]; then
        configure_laravel_advisory_whitelist "$project_dir"
    fi
    enable_larastan "$project_dir"
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    if [[ $supports_fractional_timeouts == 1 ]]; then
        run_phpstan_case "$project_dir" phpstan.neon valid-fractional.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-fractional.php
    fi
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    if [[ $supports_fractional_timeouts == 1 ]]; then
        run_documentation_phpstan_case illuminate-http "$project_dir" phpstan.neon "$documentation_case" illuminate-http-invalid
    fi
}

run_simple_illuminate_integration() {
    local integration=${FIXTURE_SUITE#illuminate-}
    local project_dir=$WORK_DIR/$FIXTURE_SUITE
    local package=illuminate/$integration
    local package_constraint
    local package_major=${PACKAGE_MAJOR%%.*}
    local profile_case=$package_major
    local expected_diagnostics=()
    local documentation_case=$project_dir/cases/documentation-invalid.php

    if [[ ! $package_major =~ ^(11|12|13)$ ]]; then
        printf '%s consumer tests require framework major 11, 12, or 13.\n' "$package" >&2
        exit 2
    fi

    if [[ $PACKAGE_MAJOR == *.* ]]; then
        if [[
            (
                $FIXTURE_SUITE != illuminate-queue
                || ! $PACKAGE_MAJOR =~ ^(11\.(52|53)\.0|12\.(59|60)\.0|13\.(9|10)\.0)$
            )
            && (
                $FIXTURE_SUITE != illuminate-auth
                || ! $PACKAGE_MAJOR =~ ^(11\.(30|31|44|45)\.0|12\.(13|14|20|44|45)\.0|12\.19\.3)$
            )
            && (
                $FIXTURE_SUITE != illuminate-database
                || ! $PACKAGE_MAJOR =~ ^12\.(50|51)\.0$
            )
            && (
                $FIXTURE_SUITE != illuminate-console
                || ! $PACKAGE_MAJOR =~ ^13\.(1\.1|2\.0)$
            )
            && (
                $FIXTURE_SUITE != illuminate-bus
                || ! $PACKAGE_MAJOR =~ ^12\.(51|52)\.0$
            )
            || $COMPATIBILITY_MODE != plain
        ]]; then
            printf '%s\n' \
                'Exact Illuminate component profiles are limited to the documented Auth, Bus, Console, Database, and Queue cutovers in plain mode.' >&2
            exit 2
        fi

        package=laravel/framework
        package_constraint=$PACKAGE_MAJOR
    else
        package_constraint="^$package_major.0"
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/$FIXTURE_SUITE/." "$project_dir/"
    mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics.txt"

    if [[ $FIXTURE_SUITE == illuminate-support && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-redis && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-session && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-auth && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-console && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-bus && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-mail && $COMPATIBILITY_MODE == larastan ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-validation && $COMPATIBILITY_MODE != plain ]]; then
        mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics-larastan.txt"
    fi

    if [[ $FIXTURE_SUITE == illuminate-queue ]]; then
        if [[ $COMPATIBILITY_MODE == larastan ]]; then
            expected_diagnostics+=(
                "Illuminate\\Queue\\InteractsWithQueue::release() expects DateInterval|DateTimeInterface|unit_int<'second'>, 1&unit_int<'minute'> given"
                "Illuminate\\Queue\\WorkerOptions::\$timeout expects unit_int<'second'>, 1&unit_int<'minute'> given"
                "Illuminate\\Queue\\WorkerOptions::\$timeout expects unit_int<'second'>, int given"
                "Property Illuminate\\Queue\\WorkerOptions::\$timeout (int) does not accept mixed"
            )
        else
            expected_diagnostics+=(
                "DelayedReportJob::release() expects DateInterval|DateTimeInterface|unit_int<'second'>, 1&unit_int<'minute'> given"
                "Property Illuminate\\Queue\\WorkerOptions::\$timeout (unit_int<'second'>) does not accept 1&unit_int<'minute'>"
                "Property Illuminate\\Queue\\WorkerOptions::\$timeout (unit_int<'second'>) does not accept int"
            )
        fi
    fi

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev "$package:$package_constraint" --no-update --no-interaction
    if [[ $FIXTURE_SUITE == illuminate-session ]]; then
        composer --working-dir="$project_dir" require --dev "illuminate/database:$package_constraint" --no-update --no-interaction
    fi
    if [[ $FIXTURE_SUITE == illuminate-mail ]]; then
        composer --working-dir="$project_dir" require --dev \
            "illuminate/bus:$package_constraint" \
            "illuminate/queue:$package_constraint" \
            --no-update --no-interaction
    fi
    if [[ $FIXTURE_SUITE == illuminate-auth && $PACKAGE_MAJOR != *.* ]]; then
        composer --working-dir="$project_dir" require --dev \
            "illuminate/cache:$package_constraint" \
            "illuminate/database:$package_constraint" \
            "illuminate/hashing:$package_constraint" \
            --no-update --no-interaction
    fi
    if [[ $PACKAGE_MAJOR == *.* || $PACKAGE_MAJOR == 11 || $COMPATIBILITY_MODE != plain ]]; then
        configure_laravel_advisory_whitelist "$project_dir"
    fi
    enable_larastan "$project_dir"
    enable_phpstan_laravel_validation "$project_dir"
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php"
    if [[ $FIXTURE_SUITE == illuminate-queue ]]; then
        profile_case=pre-stop-when-empty
        if php -r "
            require \$argv[1];
            exit(property_exists(Illuminate\Queue\WorkerOptions::class, 'stopWhenEmptyFor') ? 0 : 1);
        " "$project_dir/vendor/autoload.php"; then
            if [[ $package_major == 13 ]]; then
                profile_case=13
            else
                profile_case=12
            fi
        fi
    fi
    if [[ $FIXTURE_SUITE == illuminate-auth ]]; then
        profile_case=$([[ $package_major == 11 ]] && printf '11' || printf '12')
    fi
    if [[ $FIXTURE_SUITE == illuminate-bus ]]; then
        profile_case=pre-ranged
        local bus_progress_type="unit_int<'percent'>"
        if [[ $package_major == 13 ]] || [[
            $package_major == 12
            && ($PACKAGE_MAJOR != *.* || $(printf '%s\n' '12.52.0' "$PACKAGE_MAJOR" | sort -V | head -n 1) == 12.52.0)
        ]]; then
            profile_case=ranged
            bus_progress_type="int&unit_int<'percent'>"
        fi
        expected_diagnostics+=(
            "Illuminate\\Bus\\Queueable::delay() expects array|DateInterval|DateTimeInterface|unit_int<'second'>|null, $bus_progress_type given"
        )
    fi
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    if [[ $COMPATIBILITY_MODE == larastan && -f $project_dir/cases/valid-larastan.php ]]; then
        run_phpstan_case "$project_dir" phpstan.neon valid-larastan.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-larastan.php
    fi
    if [[ $COMPATIBILITY_MODE == phpstan-laravel-validation ]]; then
        run_phpstan_case "$project_dir" phpstan.neon valid-phpstan-laravel-validation.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-phpstan-laravel-validation.php
    fi
    if [[ -f $project_dir/cases/valid-$profile_case.php ]]; then
        run_phpstan_case "$project_dir" phpstan.neon "valid-$profile_case.php"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon "valid-$profile_case.php"
    fi
    if [[ $FIXTURE_SUITE == illuminate-auth ]]; then
        local database_expiry_type
        local invalid_database_expiry
        if [[ $package_major == 11 ]]; then
            database_expiry_type="unit_int<'minute'>"
            invalid_database_expiry="3600&unit_int<'second'>"
        else
            database_expiry_type="unit_int<'second'>"
            invalid_database_expiry="60&unit_int<'minute'>"
        fi
        run_phpstan_case "$project_dir" phpstan.neon "invalid-$profile_case.php" \
            "DatabaseTokenRepository constructor expects $database_expiry_type, $invalid_database_expiry given" \
            "DatabaseTokenRepository constructor expects $database_expiry_type, int given"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon "invalid-$profile_case.php" \
            "DatabaseTokenRepository constructor expects $database_expiry_type, $invalid_database_expiry given" \
            "DatabaseTokenRepository constructor expects $database_expiry_type, int given"

        # shellcheck disable=SC2016
        if php -r 'require $argv[1]; exit(class_exists(Illuminate\Auth\Passwords\CacheTokenRepository::class) ? 0 : 1);' \
            "$project_dir/vendor/autoload.php"; then
            run_phpstan_case "$project_dir" phpstan.neon valid-cache.php
            run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-cache.php
            run_phpstan_case "$project_dir" phpstan.neon invalid-cache.php \
                "CacheTokenRepository constructor expects unit_int<'second'>, 60&unit_int<'minute'> given" \
                "CacheTokenRepository constructor expects unit_int<'second'>, 1&unit_int<'minute'> given" \
                "CacheTokenRepository constructor expects unit_int<'second'>, int given" \
                "CacheTokenRepository constructor expects unit_int<'second'>, int given"
            run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-cache.php \
                "CacheTokenRepository constructor expects unit_int<'second'>, 60&unit_int<'minute'> given" \
                "CacheTokenRepository constructor expects unit_int<'second'>, 1&unit_int<'minute'> given" \
                "CacheTokenRepository constructor expects unit_int<'second'>, int given" \
                "CacheTokenRepository constructor expects unit_int<'second'>, int given"
        fi

        # shellcheck disable=SC2016
        if php -r '
            require $argv[1];
            foreach ((new ReflectionMethod(Illuminate\Auth\SessionGuard::class, "__construct"))->getParameters() as $parameter) {
                if ($parameter->getName() === "timeboxDuration") {
                    exit(0);
                }
            }
            exit(1);
        ' "$project_dir/vendor/autoload.php"; then
            run_phpstan_case "$project_dir" phpstan.neon valid-timebox.php
            run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-timebox.php
            run_phpstan_case "$project_dir" phpstan.neon invalid-timebox.php \
                "SessionGuard constructor expects unit_int<'1/1000000 * second'>, 1&unit_int<'second'> given" \
                "SessionGuard constructor expects unit_int<'1/1000000 * second'>, int given" \
                "PasswordBroker constructor expects unit_int<'1/1000000 * second'>, 1&unit_int<'second'> given" \
                "PasswordBroker constructor expects unit_int<'1/1000000 * second'>, int given"
            run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-timebox.php \
                "SessionGuard constructor expects unit_int<'1/1000000 * second'>, 1&unit_int<'second'> given" \
                "SessionGuard constructor expects unit_int<'1/1000000 * second'>, int given" \
                "PasswordBroker constructor expects unit_int<'1/1000000 * second'>, 1&unit_int<'second'> given" \
                "PasswordBroker constructor expects unit_int<'1/1000000 * second'>, int given"
        fi
    fi
    if [[ $FIXTURE_SUITE == illuminate-database ]] && php -r "
        require \$argv[1];
        exit(method_exists(Illuminate\\Database\\Query\\Builder::class, 'timeout') ? 0 : 1);
    " "$project_dir/vendor/autoload.php"; then
        local timeout_property_diagnostic_prefix="Builder::\$timeout expects unit_int<'second'>|null,"
        run_phpstan_case "$project_dir" phpstan.neon invalid-timeout.php \
            "Builder::timeout() expects unit_int<'second'>|null, int given" \
            "Builder::timeout() expects unit_int<'second'>|null, 500&unit_int<'1/1000 * second'> given" \
            "$timeout_property_diagnostic_prefix int" \
            "$timeout_property_diagnostic_prefix 500&unit_int<'1/1000 * second'>"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-timeout.php \
            "Builder::timeout() expects unit_int<'second'>|null, int given" \
            "Builder::timeout() expects unit_int<'second'>|null, 500&unit_int<'1/1000 * second'> given" \
            "$timeout_property_diagnostic_prefix int" \
            "$timeout_property_diagnostic_prefix 500&unit_int<'1/1000 * second'>"
        run_phpstan_case "$project_dir" phpstan.neon valid-timeout.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-timeout.php
    fi
    # The single-quoted argument is a PHP program, not a shell expression.
    # shellcheck disable=SC2016
    if [[ $FIXTURE_SUITE == illuminate-database && $COMPATIBILITY_MODE == plain ]] && php -r '
        require $argv[1];
        $doc = (new ReflectionMethod(Illuminate\Database\Connection::class, "whenQueryingForLongerThan"))
            ->getDocComment();
        exit(is_string($doc) && str_contains($doc, "\\Illuminate\\Database\\Events\\QueryExecuted): mixed") ? 0 : 1);
    ' "$project_dir/vendor/autoload.php"; then
        run_phpstan_case "$project_dir" phpstan.neon invalid-callback.php \
            'whenQueryingForLongerThan() expects callable(Illuminate\Database\Connection, Illuminate\Database\Events\QueryExecuted): mixed, Closure(string): void given'
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-callback.php \
            'whenQueryingForLongerThan() expects callable(Illuminate\Database\Connection, Illuminate\Database\Events\QueryExecuted): mixed, Closure(string): void given'
    fi
    if [[ $FIXTURE_SUITE == illuminate-queue && $COMPATIBILITY_MODE == larastan ]]; then
        run_phpstan_without_apocrypha_diagnostic "$project_dir" phpstan.neon unknown-unpack.php
        run_phpstan_without_apocrypha_diagnostic "$project_dir" phpstan-autodetect.neon unknown-unpack.php
        run_phpstan_without_apocrypha_diagnostic "$project_dir" phpstan.neon property-case.php
        run_phpstan_without_apocrypha_diagnostic "$project_dir" phpstan-autodetect.neon property-case.php
    fi
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    if [[ $FIXTURE_SUITE == illuminate-redis ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-redis "$project_dir" phpstan.neon "$documentation_case" illuminate-redis-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-routing ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-routing "$project_dir" phpstan.neon "$documentation_case" illuminate-routing-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-session ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-session "$project_dir" phpstan.neon "$documentation_case" illuminate-session-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-database ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-database "$project_dir" phpstan.neon "$documentation_case" illuminate-database-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-validation ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-validation "$project_dir" phpstan.neon "$documentation_case" illuminate-validation-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-auth ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-auth "$project_dir" phpstan.neon "$documentation_case" illuminate-auth-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-console ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-console "$project_dir" phpstan.neon "$documentation_case" illuminate-console-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-bus ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-bus "$project_dir" phpstan.neon "$documentation_case" illuminate-bus-invalid
    fi
    if [[ $FIXTURE_SUITE == illuminate-mail ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case illuminate-mail "$project_dir" phpstan.neon "$documentation_case" illuminate-mail-invalid
    fi
}

run_laravel_framework() {
    local project_dir=$WORK_DIR/laravel-framework
    local expected_diagnostics=(
        "SessionGuard::setRememberDuration() expects unit_int<'minute'>, 30&unit_int<'second'> given"
        "Illuminate\\Bus\\Queueable::delay() expects array|DateInterval|DateTimeInterface|unit_int<'second'>|null, 1&unit_int<'minute'> given"
        "Illuminate\\Bus\\Queueable::delay() expects array|DateInterval|DateTimeInterface|unit_int<'second'>|null, 2&unit_int<'minute'> given"
        "Illuminate\\Bus\\Queueable::\$delay expects array|DateInterval|DateTimeInterface|unit_int<'second'>|null, 3&unit_int<'minute'> given"
        "Store::put() expects unit_int<'second'>, 1&unit_int<'minute'> given"
        "Event::withoutOverlapping() expects unit_int<'minute'>, 30&unit_int<'second'> given"
        "Factory::make() expects unit_int<'minute'>, 30&unit_int<'second'> given"
        "Connection::whenQueryingForLongerThan() expects Carbon\\CarbonInterval|DateTimeInterface|unit_float<'1/1000 * second'>|unit_int<'1/1000 * second'>, 1&unit_int<'second'> given"
        "acceptFrameworkMeters expects unit_int<'meter'>, unit_int<'octet'> given"
        "timeout() expects unit_float<'second'>|unit_int<'second'>, 500&unit_int<'1/1000 * second'> given"
        "Mailer::later() expects DateInterval|DateTimeInterface|unit_int<'second'>, 1&unit_int<'minute'> given"
        "Queue::later() expects DateInterval|DateTimeInterface|unit_int<'second'>, 1&unit_int<'minute'> given"
        "DurationLimiterBuilder::sleep() expects unit_int<'1/1000 * second'>, 1&unit_int<'second'> given"
        "Route::block() expects unit_int<'second'>|null, 1&unit_int<'minute'> given"
        "ArraySessionHandler constructor expects unit_int<'minute'>, 30&unit_int<'second'> given"
        "Sleep::sleep() expects unit_float<'second'>|unit_int<'second'>, 500&unit_int<'1/1000 * second'> given"
        "Dimensions::width() expects unit_int<'pixel'>, 1200&unit_int<'css_pixel'> given"
        "File::max() expects string|unit_int<'1024 * octet'>, 2&unit_int<'1000000 * octet'> given"
        "WorkerOptions constructor expects unit_int<'1048576 * octet'>, 128&unit_int<'1000000 * octet'> given"
    )

    if [[ ! $PACKAGE_MAJOR =~ ^(11|12|13)$ ]]; then
        printf 'Laravel framework consumer tests require framework major 11, 12, or 13.\n' >&2
        exit 2
    fi

    if [[ $PACKAGE_MAJOR == 13 ]]; then
        expected_diagnostics+=(
            "PendingProcess::timeout() expects Carbon\\CarbonInterval|unit_int<'second'>, 1&unit_int<'minute'> given"
        )
    else
        expected_diagnostics+=(
            "PendingProcess::timeout() expects unit_int<'second'>, 1&unit_int<'minute'> given"
        )
    fi

    if [[ $PACKAGE_MAJOR == 11 ]]; then
        expected_diagnostics+=(
            "acceptFrameworkBusSeconds expects unit_int<'second'>, unit_int<'percent'> given"
        )
    else
        expected_diagnostics+=(
            "acceptFrameworkBusSeconds expects unit_int<'second'>, int&unit_int<'percent'> given"
        )
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/laravel-framework/." "$project_dir/"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "laravel/framework:^$PACKAGE_MAJOR.0" --no-update --no-interaction
    configure_laravel_advisory_whitelist "$project_dir"
    enable_larastan "$project_dir"
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php" "$PACKAGE_MAJOR"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
}

