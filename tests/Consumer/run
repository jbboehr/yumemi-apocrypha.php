    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan.neon documentation-invalid.php \
        "array{timeout: 250&unit_int<'1/1000 * second'>} given"
}

run_phpgeo() {
    local project_dir=$WORK_DIR/phpgeo
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local expected_diagnostics=()

    if [[ ! $PACKAGE_MAJOR =~ ^(4|5|6)$ ]]; then
        printf 'phpgeo consumer tests require package major 4, 5, or 6.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/phpgeo/." "$project_dir/"
    mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics.txt"

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    if [[ -n $yumemi_repository_json ]]; then
        composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
    fi
    composer --working-dir="$project_dir" require --dev "mjaschen/phpgeo:^$PACKAGE_MAJOR.0" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    php "$project_dir/verify.php"
    php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
        "$PROJECT_ROOT/docs/pages/integrations.md" phpgeo-invalid > "$documentation_case"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan.neon documentation-invalid.php \
        "calculateDestination() expects unit_float<'arc_degree'>, unit_float<'radian'> given"
}

run_getid3() {
    local project_dir=$WORK_DIR/getid3
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local invalid_case
    local package_constraint
    local valid_case
    local expected_diagnostics_file
    local expected_diagnostics=()

    case $PACKAGE_MAJOR in
        1)
            package_constraint='^1.9.22'
            valid_case=valid.php
            invalid_case=invalid.php
            expected_diagnostics_file=expected-diagnostics.txt
            ;;
        1.9.22)
            package_constraint=$PACKAGE_MAJOR
            valid_case=valid.php
            invalid_case=invalid.php
            expected_diagnostics_file=expected-diagnostics.txt
            ;;
        2)
            package_constraint='^2.0.0-beta6'
            valid_case=valid-2.php
            invalid_case=invalid-2.php
            expected_diagnostics_file=expected-diagnostics-2.txt
            ;;
        2.0.0-beta6)
            package_constraint=$PACKAGE_MAJOR
            valid_case=valid-2.php
            invalid_case=invalid-2.php
            expected_diagnostics_file=expected-diagnostics-2.txt
            ;;
        *)
            printf 'getID3 consumer tests require version 1, 1.9.22, 2, or 2.0.0-beta6.\n' >&2
            exit 2
            ;;
    esac

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/getid3/." "$project_dir/"
    mapfile -t expected_diagnostics < "$project_dir/$expected_diagnostics_file"

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    if [[ -n $yumemi_repository_json ]]; then
        composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
    fi
    composer --working-dir="$project_dir" require --dev \
        "james-heinrich/getid3:$package_constraint" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    php "$project_dir/verify.php"
    run_phpstan_case "$project_dir" phpstan.neon "$valid_case"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "$valid_case"
    run_phpstan_case "$project_dir" phpstan.neon "$invalid_case" "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "$invalid_case" "${expected_diagnostics[@]}"

    if [[ $PACKAGE_MAJOR == 2 || $PACKAGE_MAJOR == 2.0.0-beta6 ]]; then
        php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
            "$PROJECT_ROOT/docs/pages/integrations.md" getid3-invalid > "$documentation_case"
        run_phpstan_case "$project_dir" phpstan.neon documentation-invalid.php \
            "recordMediaDuration expects unit_float<'second'>|unit_int<'second'>, unit_float<'bit / second'>|unit_int<'bit / second'> given"
    fi
}

run_manual() {
    local project_dir=$WORK_DIR/manual

    if [[ $PACKAGE_MAJOR != 12 ]]; then
        printf 'The manual-registration smoke test uses Illuminate Cache major 12.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/manual/." "$project_dir/"

    composer --working-dir="$project_dir" repo add apocrypha "$repository_json" --no-interaction
    if [[ -n $yumemi_repository_json ]]; then
        composer --working-dir="$project_dir" repo add yumemi "$yumemi_repository_json" --no-interaction
    fi
    composer --working-dir="$project_dir" require --dev "illuminate/cache:^$PACKAGE_MAJOR.0" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php \
        "Store::put() expects unit_int<'second'>, int given"
}

case $FIXTURE_SUITE in
    getid3)
        run_getid3
        ;;
    guzzle)
        run_guzzle
        ;;
    illuminate-cache)
        run_illuminate_cache
        ;;
    illuminate-http)
        run_illuminate_http
        ;;
    illuminate-cookie | illuminate-filesystem | illuminate-process | illuminate-queue | illuminate-support)
        run_simple_illuminate_integration
        ;;
    laravel-framework)
        run_laravel_framework
        ;;
    phpgeo)
        run_phpgeo
        ;;
    symfony-stopwatch)
        run_symfony_stopwatch
        ;;
    manual)
        run_manual
        ;;
    *)
        printf 'Usage: %s [source|archive] [getid3|guzzle|illuminate-cache|illuminate-cookie|illuminate-filesystem|illuminate-http|illuminate-process|illuminate-queue|illuminate-support|laravel-framework|phpgeo|symfony-stopwatch|manual] [package-version]\n' "$0" >&2
        exit 2
        ;;
esac

printf '%s consumer package tests passed using the %s package.\n' "$FIXTURE_SUITE" "$PACKAGE_MODE"
