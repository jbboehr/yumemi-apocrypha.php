run_intervention_image() {
    local project_dir=$WORK_DIR/intervention-image
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local package_constraint
    local profile
    case $PACKAGE_MAJOR in
        3.0.0)
            package_constraint=$PACKAGE_MAJOR
            profile=3
            ;;
        3)
            package_constraint='^3.0'
            profile=3
            ;;
        4.0.0)
            package_constraint=$PACKAGE_MAJOR
            profile=4
            ;;
        4)
            package_constraint='^4.0'
            profile=4
            ;;
        *)
            printf 'Intervention Image consumer tests require version 3, 3.0.0, 4, or 4.0.0.\n' >&2
            exit 2
            ;;
    esac

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/intervention-image/." "$project_dir/"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "intervention/image:$package_constraint" --no-update --no-interaction
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php"
    run_phpstan_case "$project_dir" phpstan.neon "valid-$profile.php"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "valid-$profile.php"

    local expected_diagnostics=()
    if [[ $profile == 3 ]]; then
        expected_diagnostics=(
            "ImageManager::create() expects unit_int<'pixel'>, int given"
            "ImageInterface::resize() expects unit_int<'pixel'>|null, 1&unit_int<'second'> given"
            "ImageInterface::rotate() expects unit_float<'arc_degree'>, 1.0&unit_float<'radian'> given"
            "ImageInterface::crop() expects unit_int<'pixel'>, 1&unit_int<'meter'> given"
            "recordInterventionThreeSeconds expects unit_int<'second'>, unit_int<'pixel'> given"
        )
    else
        expected_diagnostics=(
            "ImageManager::createImage() expects unit_int<'pixel'>, int given"
            "ImageInterface::resize() expects Intervention\\Image\\Fraction|unit_int<'pixel'>|null, 1&unit_int<'second'> given"
            "ImageInterface::rotate() expects unit_float<'arc_degree'>, 1.0&unit_float<'radian'> given"
            "ImageInterface::crop() expects unit_int<'pixel'>, 1&unit_int<'meter'> given"
            "recordInterventionFourSeconds expects unit_int<'second'>, unit_int<'pixel'> given"
        )
    fi

    run_phpstan_case "$project_dir" phpstan.neon "invalid-$profile.php" "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "invalid-$profile.php" "${expected_diagnostics[@]}"

    if [[ $profile == 4 ]]; then
        # Keep registration calls on one line; PublicDocumentationExamplesTest inventories this form.
        run_documentation_phpstan_case intervention-image "$project_dir" phpstan.neon "$documentation_case" intervention-image-invalid
    fi
}

run_getid3() {
    local project_dir=$WORK_DIR/getid3
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local invalid_case
    local package_constraint
    local valid_case
    local expected_diagnostics_file
    local expected_diagnostics=()

    case $PACKAGE_MAJOR in
        1)
            package_constraint='^1.9.22'
            valid_case=valid.php
            invalid_case=invalid.php
            expected_diagnostics_file=expected-diagnostics.txt
            ;;
        1.9.22)
            package_constraint=$PACKAGE_MAJOR
            valid_case=valid.php
            invalid_case=invalid.php
            expected_diagnostics_file=expected-diagnostics.txt
            ;;
        2)
            package_constraint='^2.0.0-beta6'
            valid_case=valid-2.php
            invalid_case=invalid-2.php
            expected_diagnostics_file=expected-diagnostics-2.txt
            ;;
        2.0.0-beta6)
            package_constraint=$PACKAGE_MAJOR
            valid_case=valid-2.php
            invalid_case=invalid-2.php
            expected_diagnostics_file=expected-diagnostics-2.txt
            ;;
        *)
            printf 'getID3 consumer tests require version 1, 1.9.22, 2, or 2.0.0-beta6.\n' >&2
            exit 2
            ;;
    esac

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/getid3/." "$project_dir/"
    mapfile -t expected_diagnostics < "$project_dir/$expected_diagnostics_file"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "james-heinrich/getid3:$package_constraint" --no-update --no-interaction
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php"
    run_phpstan_case "$project_dir" phpstan.neon "$valid_case"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "$valid_case"
    run_phpstan_case "$project_dir" phpstan.neon "$invalid_case" "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon "$invalid_case" "${expected_diagnostics[@]}"

    if [[ $PACKAGE_MAJOR == 2 || $PACKAGE_MAJOR == 2.0.0-beta6 ]]; then
        run_documentation_phpstan_case getid3 "$project_dir" phpstan.neon "$documentation_case" getid3-invalid
    fi
}

run_manual() {
    local project_dir=$WORK_DIR/manual

    if [[ $PACKAGE_MAJOR != 12 ]]; then
        printf 'The manual-registration smoke test uses Illuminate Cache major 12.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/manual/." "$project_dir/"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev "illuminate/cache:^$PACKAGE_MAJOR.0" --no-update --no-interaction
    install_consumer_dependencies "$project_dir"

    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php \
        "Store::put() expects unit_int<'second'>, int given"
}

case $FIXTURE_SUITE in
    carbon)
        run_carbon
        ;;
    getid3)
        run_getid3
        ;;
    guzzle)
        run_guzzle
        ;;
    illuminate-cache)
        run_illuminate_cache
        ;;
    illuminate-http)
        run_illuminate_http
        ;;
    illuminate-auth | illuminate-bus | illuminate-console | illuminate-cookie | illuminate-database | illuminate-filesystem | illuminate-mail | illuminate-process | illuminate-queue | illuminate-redis | illuminate-routing | illuminate-session | illuminate-support | illuminate-validation)
        run_simple_illuminate_integration
        ;;
    intervention-image)
        run_intervention_image
        ;;
    laravel-framework)
        run_laravel_framework
        ;;
    measurements)
        run_measurements
        ;;
    phpgeo)
        run_phpgeo
        ;;
    symfony-http-foundation)
        run_symfony_http_foundation
        ;;
    symfony-stopwatch)
        run_symfony_stopwatch
        ;;
    manual)
        run_manual
        ;;
    *)
        printf 'Usage: %s [source|archive] [carbon|getid3|guzzle|illuminate-auth|illuminate-bus|illuminate-cache|illuminate-console|illuminate-cookie|illuminate-database|illuminate-filesystem|illuminate-http|illuminate-mail|illuminate-process|illuminate-queue|illuminate-redis|illuminate-routing|illuminate-session|illuminate-support|illuminate-validation|intervention-image|laravel-framework|measurements|phpgeo|symfony-http-foundation|symfony-stopwatch|manual] [package-version] [plain|larastan|phpstan-laravel-validation|phpstan-symfony]\n' "$0" >&2
        exit 2
        ;;
esac

printf '%s consumer package tests passed using the %s package.\n' "$FIXTURE_SUITE" "$PACKAGE_MODE"
