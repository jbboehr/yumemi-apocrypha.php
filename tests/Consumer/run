run_symfony_http_foundation() {
    local project_dir=$WORK_DIR/symfony-http-foundation
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local package_constraint
    local has_sse=0
    local has_ip_byte_counts=0
    local expected_diagnostics=()
    local expected_sse_diagnostics=()
    local expected_ip_diagnostics=()

    case $PACKAGE_MAJOR in
        6.4.0)
            package_constraint=6.4.0
            ;;
        6)
            package_constraint='^6.4.0'
            ;;
        7.2.9)
            package_constraint=7.2.9
            ;;
        7.3.0)
            package_constraint=7.3.0
            has_sse=1
            ;;
        7)
            package_constraint='^7.0'
            has_sse=1
            ;;
        8.0.0)
            package_constraint=8.0.0
            has_sse=1
            has_ip_byte_counts=1
            ;;
        8)
            package_constraint='^8.0'
            has_sse=1
            has_ip_byte_counts=1
            ;;
        *)
            printf 'Symfony HttpFoundation consumer tests require version 6.4.0, 6, 7.2.9, 7.3.0, 7, 8.0.0, or 8.\n' >&2
            exit 2
            ;;
    esac

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/symfony-http-foundation/." "$project_dir/"
    mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics.txt"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "symfony/http-foundation:$package_constraint" --no-update --no-interaction
    enable_phpstan_symfony "$project_dir"
    install_consumer_dependencies "$project_dir"

    php "$project_dir/verify.php"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"

    if [[ $has_sse == 1 ]]; then
        mapfile -t expected_sse_diagnostics < "$project_dir/expected-diagnostics-sse.txt"
        run_phpstan_case "$project_dir" phpstan.neon valid-sse.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-sse.php
        run_phpstan_case "$project_dir" phpstan.neon invalid-sse.php "${expected_sse_diagnostics[@]}"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-sse.php "${expected_sse_diagnostics[@]}"
    fi

    if [[ $has_ip_byte_counts == 1 ]]; then
        mapfile -t expected_ip_diagnostics < "$project_dir/expected-diagnostics-ip.txt"
        run_phpstan_case "$project_dir" phpstan.neon valid-ip.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-ip.php
        run_phpstan_case "$project_dir" phpstan.neon invalid-ip.php "${expected_ip_diagnostics[@]}"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-ip.php "${expected_ip_diagnostics[@]}"
    fi

    run_documentation_phpstan_case symfony-http-foundation "$project_dir" phpstan.neon "$documentation_case" symfony-http-foundation-invalid
}

run_guzzle() {
    local project_dir=$WORK_DIR/guzzle
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local package_constraint
    local supports_fractional_delay=1
    local expected_diagnostics=()

    case $PACKAGE_MAJOR in
        7.10.0)
            package_constraint=7.10.0
            supports_fractional_delay=0
            ;;
        7.11.0)
            package_constraint=7.11.0
            ;;
        7 | 8)
            package_constraint="^$PACKAGE_MAJOR.0"
            ;;
        *)
            printf 'Guzzle consumer tests require package major 7, 8, or profile 7.10.0/7.11.0.\n' >&2
            exit 2
            ;;
    esac

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/guzzle/." "$project_dir/"
    mapfile -t expected_diagnostics < "$project_dir/expected-diagnostics.txt"

    configure_apocrypha_repository "$project_dir"
    configure_yumemi_repository "$project_dir"
    composer --working-dir="$project_dir" require --dev \
        "guzzlehttp/guzzle:$package_constraint" --no-update --no-interaction
    if [[ $PACKAGE_MAJOR == *.* ]]; then
        composer --working-dir="$project_dir" config policy.advisories.ignore guzzlehttp/guzzle
    fi
    install_consumer_dependencies "$project_dir"

    assert_stub_paths_use_consumer_install "$project_dir" guzzlehttp/guzzle
    php "$project_dir/verify.php" "$project_dir/$CONSUMER_VENDOR_DIR/autoload.php"
    run_phpstan_case "$project_dir" phpstan.neon valid.php
    run_phpstan_case "$project_dir" phpstan-autodetect.neon valid.php
    local package_major=${PACKAGE_MAJOR%%.*}
    if [[ -f $project_dir/cases/valid-$package_major.php ]]; then
        run_phpstan_case "$project_dir" phpstan.neon "valid-$package_major.php"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon "valid-$package_major.php"
    fi
    if [[ $supports_fractional_delay == 1 ]]; then
        run_phpstan_case "$project_dir" phpstan.neon valid-fractional-delay.php
        run_phpstan_case "$project_dir" phpstan-autodetect.neon valid-fractional-delay.php
    else
        run_phpstan_case "$project_dir" phpstan.neon invalid-integer-delay.php \
            "array{delay: 0.5&unit_float<'1/1000 * second'>} given"
        run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid-integer-delay.php \
            "array{delay: 0.5&unit_float<'1/1000 * second'>} given"
    fi
    run_phpstan_case "$project_dir" phpstan.neon invalid.php "${expected_diagnostics[@]}"
    run_phpstan_case "$project_dir" phpstan-autodetect.neon invalid.php "${expected_diagnostics[@]}"
    run_documentation_phpstan_case guzzle "$project_dir" phpstan.neon "$documentation_case" guzzle-invalid
}

