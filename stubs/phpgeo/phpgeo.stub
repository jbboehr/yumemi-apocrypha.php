namespace Location\Bearing;

interface BearingInterface
{
    /**
     * @return float
     *
     * @phpstan-return unit_float<'degree'>
     * @yumemi-return unit_float<'degree'>
     */
    public function calculateBearing(\Location\Coordinate $point1, \Location\Coordinate $point2): float;

    /**
     * @return float
     *
     * @phpstan-return unit_float<'degree'>
     * @yumemi-return unit_float<'degree'>
     */
    public function calculateFinalBearing(\Location\Coordinate $point1, \Location\Coordinate $point2): float;

    /**
     * @param float $bearing
     * @param float $distance
     *
     * @phpstan-param unit_float<'degree'> $bearing
     * @phpstan-param unit_float<'meter'> $distance
     * @yumemi-param unit_float<'degree'> $bearing
     * @yumemi-param unit_float<'meter'> $distance
     */
    public function calculateDestination(
        \Location\Coordinate $point,
        float $bearing,
        float $distance,
    ): \Location\Coordinate;
}

