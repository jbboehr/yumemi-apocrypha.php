        ?callable $callback = null,
        int $status = 200,
        array $headers = [],
        private ?int $retry = null,
    ) {
    }

    /**
     * @phpstan-return unit_int<'millisecond'>|null
     * @yumemi-return unit_int<'millisecond'>|null
     */
    public function getRetry(): ?int
    {
    }

    /**
     * @phpstan-param unit_int<'millisecond'> $retry
     * @yumemi-param unit_int<'millisecond'> $retry
     */
    public function setRetry(int $retry): void
    {
    }
}

class ServerEvent implements \IteratorAggregate
{
    /**
     * @param string|iterable<string> $data
     * @phpstan-param unit_int<'millisecond'>|null $retry
     * @yumemi-param unit_int<'millisecond'>|null $retry
     */
    public function __construct(
        private string|iterable $data,
        private ?string $type = null,
        private ?int $retry = null,
        private ?string $id = null,
        private ?string $comment = null,
    ) {
    }

    /**
     * @phpstan-return unit_int<'millisecond'>|null
     * @yumemi-return unit_int<'millisecond'>|null
     */
    public function getRetry(): ?int
    {
    }

    /**
     * @phpstan-param unit_int<'millisecond'>|null $retry
     * @yumemi-param unit_int<'millisecond'>|null $retry
     */
    public function setRetry(?int $retry): static
    {
    }
}
