<?php

namespace Illuminate\Contracts\Routing;

interface UrlGenerator
{
    /**
     * @param \DateTimeInterface|\DateInterval|int|null $expiration
     *
     * @phpstan-param \DateTimeInterface|\DateInterval|unit_int<'second'>|null $expiration
     * @yumemi-param \DateTimeInterface|\DateInterval|unit_int<'second'>|null $expiration
     */
    public function signedRoute($name, $parameters = [], $expiration = null, $absolute = true);

    /**
     * @param \DateTimeInterface|\DateInterval|int $expiration
     *
     * @phpstan-param \DateTimeInterface|\DateInterval|unit_int<'second'> $expiration
     * @yumemi-param \DateTimeInterface|\DateInterval|unit_int<'second'> $expiration
     */
    public function temporarySignedRoute($name, $expiration, $parameters = [], $absolute = true);
}

